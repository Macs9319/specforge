# Postgres connection string used by both the Next.js app and Prisma migrations.
# When running via docker-compose, "postgres" is the service hostname; when
# running the app directly on the host, use "localhost" instead.
DATABASE_URL=postgresql://specforge:specforge@localhost:5432/specforge

NODE_ENV=development

# fatal | error | warn | info | debug | trace
LOG_LEVEL=info
