# Postgres connection string used by both the Next.js app and Prisma migrations.
# When running via docker-compose, "postgres" is the service hostname; when
# running the app directly on the host, use "localhost" instead.
DATABASE_URL=postgresql://specforge:specforge@localhost:5432/specforge

NODE_ENV=development

# fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# Secret used by Auth.js to sign/encrypt session tokens. Generate one with:
#   openssl rand -base64 32
AUTH_SECRET=

# Read by `docker compose` itself (not the app) to run the `web` container as
# your host user, so files it writes into the bind-mounted repo (e.g.
# generated/prisma, .next) aren't root-owned. Run `id -u` / `id -g` if your
# host user isn't 1000:1000.
UID=1000
GID=1000

# S3-compatible object storage for uploaded documents. Points at the local
# MinIO container by default; leave S3_ENDPOINT unset to use real AWS S3.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=specforge-documents
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true

# Background job queue (BullMQ), shared by the web app (producer) and the
# worker process (consumer).
REDIS_URL=redis://localhost:6379

# LLM provider used to generate the PRD. "anthropic" needs a real
# ANTHROPIC_API_KEY; "fake" returns canned output with no API calls, useful
# for trying out the app without a key.
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
# low | medium | high | xhigh | max
LLM_EFFORT=high

# Per-user cap on PRD generations (initial upload + regenerate combined) in
# a rolling 24h window.
GENERATION_DAILY_LIMIT=10
