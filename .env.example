# Postgres connection string used by both the Next.js app and Prisma migrations.
# When running via docker-compose, "postgres" is the service hostname; when
# running the app directly on the host, use "localhost" instead.
DATABASE_URL=postgresql://specforge:specforge@localhost:5432/specforge

NODE_ENV=development

# fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# Secret used by Auth.js to sign/encrypt session tokens. Generate one with:
#   openssl rand -base64 32
AUTH_SECRET=

# Read by `docker compose` itself (not the app) to run the `web` container as
# your host user, so files it writes into the bind-mounted repo (e.g.
# generated/prisma, .next) aren't root-owned. Run `id -u` / `id -g` if your
# host user isn't 1000:1000.
UID=1000
GID=1000
