generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum SourceFileType {
  PDF
  DOCX
  MARKDOWN
  TEXT
}

enum ProcessingStatus {
  PENDING
  PROCESSING
  COMPLETE
  FAILED
}

model User {
  id               String            @id @default(cuid())
  email            String            @unique
  passwordHash     String
  name             String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  documents        Document[]
  prds             Prd[]
  generationEvents GenerationEvent[]
}

model Document {
  id               String           @id @default(cuid())
  userId           String
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  title            String
  originalFilename String
  fileType         SourceFileType
  mimeType         String
  fileSizeBytes    Int
  storageKey       String
  status           ProcessingStatus @default(PENDING)
  extractedText    String?          @db.Text
  errorMessage     String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  prd              Prd?

  @@index([userId])
}

model Prd {
  id           String           @id @default(cuid())
  documentId   String           @unique
  document     Document         @relation(fields: [documentId], references: [id], onDelete: Cascade)
  userId       String
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  status       ProcessingStatus @default(PENDING)
  errorMessage String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  // Superseded by PrdVersion (below): a successful generation or an edit
  // now creates/updates a PrdVersion row instead of writing here directly.
  // Left in place, unused, so the "contract" migration that drops them can
  // ship in a later release once the PrdVersion path is proven.
  content      String?          @db.Text
  modelId      String?
  inputTokens  Int?
  outputTokens Int?
  generatedAt  DateTime?
  editedAt     DateTime?

  versions         PrdVersion[] @relation("PrdVersions")
  currentVersionId String?      @unique
  currentVersion   PrdVersion?  @relation("CurrentVersion", fields: [currentVersionId], references: [id])

  @@index([userId])
}

// One row per successful generation or edit. Prd.currentVersionId points at
// whichever row is "live"; regenerating creates a new row and repoints it,
// so the previous content is never destroyed. A FAILED generation attempt
// produces no content and therefore no version row.
model PrdVersion {
  id            String    @id @default(cuid())
  prdId         String
  prd           Prd       @relation("PrdVersions", fields: [prdId], references: [id], onDelete: Cascade)
  versionNumber Int
  content       String    @db.Text
  modelId       String?
  inputTokens   Int?
  outputTokens  Int?
  generatedAt   DateTime?
  editedAt      DateTime?
  createdAt     DateTime  @default(now())

  currentFor    Prd?      @relation("CurrentVersion")

  @@unique([prdId, versionNumber])
  @@index([prdId])
}

// One row per PRD generation attempt (initial upload or explicit regenerate),
// used to enforce the per-user daily generation cap. A manual "Retry" after
// a failure doesn't create a new row, since it's completing an attempt
// that was already counted.
model GenerationEvent {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}
